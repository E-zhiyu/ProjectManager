<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="PackageVisibilityPolicy,QueryAllPackagesPermission" /> <!-- 读取应用列表权限 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />  <!-- 闹钟设置权限 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" /> <!-- 请求忽略电池优化 -->
    <uses-permission android:name="com.android.permission.GET_INSTALLED_APPS" /> <!-- 读取应用列表权限 -->
    <uses-permission
        android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        tools:ignore="ProtectedPermissions" /> <!-- 通知使用权限 -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:ignore="RequestInstallPackagesPolicy" /> <!-- 安装APK权限 -->
    <uses-permission android:name="android.permission.INTERNET" /> <!-- 网络权限 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" /> <!-- 读取外部存储权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" /> <!-- 写入外部存储权限 -->
    <uses-permission android:name="android.permission.CAMERA" /> <!-- 相机权限 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" /> <!-- 开机监听权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" /> <!-- 通知权限 -->

    <uses-feature android:name="android.hardware.camera.any" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".ManagerAssistant"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ManagerAssistant.Static"
        tools:targetApi="33">
        <activity
            android:name=".ui.pages.bookkeeping.budget.BudgetAddModifyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.pages.bookkeeping.budget.BudgetManageActivity"
            android:exported="false" />
        <activity
            android:name=".ui.pages.picture.FullScreenImageActivity"
            android:exported="false" />
        <activity
            android:name=".ui.pages.picture.CameraActivity"
            android:exported="false" />
        <activity
            android:name=".ui.pages.bookkeeping.notification_analysis.package_name_select.PackageNameSelectActivity"
            android:exported="false" />
        <activity
            android:name=".ui.pages.bookkeeping.notification_analysis.rule_edit.RuleAddModifyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.pages.bookkeeping.notification_analysis.rule_edit.AnalysisRuleManageActivity"
            android:exported="false" />
        <activity
            android:name=".ui.pages.bookkeeping.tag.GroupModifyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.pages.bookkeeping.tag.TagManageActivity"
            android:exported="false" />
        <activity
            android:name=".ui.pages.bookkeeping.tag.TagAddModifyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.pages.home.report.ReportActivity"
            android:exported="false" />
        <activity
            android:name=".ui.pages.bookkeeping.running_account.RunningAccountModifyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.pages.bookkeeping.running_account.RunningAccountAddActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 预算重置检查闹钟的接收器 -->
        <receiver
            android:name=".automation.broadcast.BudgetResetReceiver"
            android:enabled="true"
            android:exported="false"
            android:label="被每天0点检查预算的闹钟触发的预算重置接收器">
            <intent-filter>
                <action android:name="com.manager.assistant.BudgetResetReceiver" />
            </intent-filter>
        </receiver>

        <!-- 开机启动监听器 -->
        <receiver
            android:name=".automation.broadcast.BootReceiver"
            android:enabled="true"
            android:exported="false"
            android:label="开机完毕的监听器，用于自动安排第二天0点的预算重置闹钟">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- 兼容旧版本 Android 需要添加以下权限 -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 通知内联回复监听器 -->
        <receiver
            android:name=".automation.broadcast.AutoBookkeepingActionsReceiver"
            android:enabled="true"
            android:exported="false"
            android:label="通过自动记账确认通知进行各种操作的接收器" />

        <!-- 通知监听服务，用于实现自动记账 -->
        <service
            android:name=".automation.services.AutoBookKeepingNotificationListenerService"
            android:exported="false"
            android:label="自动记账通知监听服务"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>