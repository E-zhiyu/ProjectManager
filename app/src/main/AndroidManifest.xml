<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".ManagerAssistant"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProjectManager">
        <activity
            android:name=".ui.bookkeeping.tag.edit.GroupModifyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.bookkeeping.tag.edit.TagModifyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.bookkeeping.tag.edit.EditActivity"
            android:exported="false" />
        <activity
            android:name=".ui.bookkeeping.tag.edit.NewTagActivity"
            android:exported="false" />
        <activity
            android:name=".ui.bookkeeping.report.ReportActivity"
            android:exported="false" />
        <activity
            android:name=".ui.bookkeeping.running_account_edit.modify.RunningAccountModifyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.bookkeeping.running_account_edit.new_running_account.NewRunningAccountActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>