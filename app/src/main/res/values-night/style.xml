<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 标题栏样式 -->
    <style name="ToolBarStyle">
        <item name="android:background">@color/toolbar_background_night</item>
        <item name="contentInsetStart">10dp</item>
        <item name="titleTextAppearance">@style/TitleStyle</item>
    </style>

    <!-- 标题文本样式 -->
    <style name="TitleStyle">
        <item name="android:textSize">23sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- 页面样式 -->
    <style name="PageStyle">
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:background">@color/page_background_night</item>
    </style>

    <!-- 对话框样式 -->
    <style name="DialogStyle">
        <item name="android:background">@color/dialog_background_night</item>
        <item name="android:padding">10dp</item>
    </style>

    <!-- 报表内容文本视图样式 -->
    <style name="ReportInfoTextViewStyle">
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:layout_marginLeft">35dp</item>
    </style>

    <!-- 标签文本视图样式 -->
    <style name="LabelTextViewStyle">
        <item name="android:layout_margin">10dp</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- 普通卡片容器器样式 -->
    <style name="CommonCardStyle">
        <item name="cardBackgroundColor">@color/card_background_night</item>
        <item name="cardCornerRadius">50dp</item>
        <item name="android:layout_margin">10dp</item>
    </style>

    <!-- 带有多项内容的卡片容器 -->
    <style name="ContentCardStyle">
        <item name="cardBackgroundColor">@color/card_background_night</item>
        <item name="cardCornerRadius">10dp</item>
        <item name="android:layout_margin">10dp</item>
    </style>

    <!-- 子设置项卡片容器样式 -->
    <style name="SubSettingCardStyle">
        <item name="android:drawableRight">@drawable/baseline_keyboard_arrow_right_24</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">5dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- 流水视图样式 -->
    <style name="FlowViewStyle">
        <item name="cardBackgroundColor">@color/card_background_night</item>
    </style>

    <!-- 新建流水界面卡片容器样式 -->
    <style name="NewFlowCardStyle">
        <item name="cardBackgroundColor">@color/page_background_night</item>
    </style>

    <!-- 按钮样式 -->
    <style name="BtnStyle" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/theme_blue_night</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:padding">10dp</item>
    </style>

    <!-- 透明背景按钮样式 -->
    <style name="TransparentBtnStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/theme_blue_night</item>
        <item name="iconPadding">2dp</item>
    </style>

    <!-- 复选框样式 -->
    <style name="CheckBoxStyle">
        <item name="buttonTint">@color/theme_blue_night</item>
    </style>

    <!-- 文本框样式 -->
    <style name="TextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/page_background_night</item>
        <item name="backgroundTint">@color/theme_blue_night</item>
        <item name="boxStrokeColor">@color/text_input_edittext_border_selector</item>
        <item name="cursorColor">@color/theme_blue_night</item>
    </style>

    <!-- 底部导航栏样式 -->
    <style name="NaviStyle">
        <item name="itemTextColor">@color/bottom_navigation_selector</item>
        <item name="itemIconTint">@color/bottom_navigation_selector</item>
        <item name="itemRippleColor">@color/ripple_night</item>
        <item name="android:background">@color/card_background_night</item>
        <item name="itemActiveIndicatorStyle">@style/NaviActiveIndicator</item>
    </style>

    <!-- 底部导航栏指示器颜色 -->
    <style name="NaviActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/navi_indicator_night</item>
    </style>

    <!-- TabLayout样式 -->
    <style name="TabLayoutStyle" parent="android:Widget">
        <item name="android:background">@color/page_background_night</item>
        <item name="tabTextColor">@color/tab_layout_selector</item>
        <item name="tabIndicatorColor">@color/theme_blue_night</item>
        <item name="tabRippleColor">@color/ripple_night</item>
    </style>

    <!-- 日期选择对话框样式 -->
    <style name="DatePickerDialogStyle" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <!-- 标题颜色 -->
        <item name="materialCalendarHeaderTitle">@color/toolbar_background_night</item>
        <!-- 选中日期的背景色 -->
        <item name="colorOnPrimary">@color/toolbar_background_night</item>
        <item name="colorPrimary">@color/theme_blue_night</item>
        <!-- 按钮文字颜色 -->
        <item name="materialButtonStyle">@style/DateTimePickerButtonStyle</item>
    </style>

    <!-- 时间选择对话框样式 -->
    <style name="TimePickerDialogStyle" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <!-- 时钟数字颜色 -->
        <item name="colorOnPrimary">@color/white</item>
        <!-- 选中状态的颜色 -->
        <item name="colorPrimary">@color/theme_blue_night</item>
        <!-- 按钮样式 -->
        <item name="materialButtonStyle">@style/DateTimePickerButtonStyle</item>
    </style>

    <!-- 日期和时间选择对话框按钮样式 -->
    <style name="DateTimePickerButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/white</item>
    </style>
</resources>