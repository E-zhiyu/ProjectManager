<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 标题栏样式 -->
    <style name="ToolBarStyle">
        <item name="android:background">@color/toolbar_background_night</item>
        <item name="contentInsetStart">10dp</item>
        <item name="titleTextAppearance">@style/TitleStyle</item>
    </style>

    <!-- 标题文本样式 -->
    <style name="TitleStyle">
        <item name="android:textSize">23sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- 页面样式 -->
    <style name="PageStyle">
        <item name="android:background">@color/page_background_night</item>
    </style>

    <!-- 卡片容器样式 -->
    <style name="CardStyle">
        <item name="cardBackgroundColor">@color/card_background_night</item>
        <item name="cardCornerRadius">50dp</item>
        <item name="android:layout_margin">10dp</item>
    </style>

    <!-- 新建流水界面卡片容器样式 -->
    <style name="NewFlowCardStyle">
        <item name="cardBackgroundColor">@color/page_background_night</item>
    </style>

    <!-- 文本视图样式 -->
    <style name="NewFlowTextViewStyle">
        <item name="android:textSize">20sp</item>
        <item name="android:layout_marginStart">10sp</item>
    </style>

    <!-- 按钮样式 -->
    <style name="BtnStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@color/theme_blue_night</item>
        <item name="android:textColor">@color/black</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:layout_margin">5dp</item>
    </style>

    <!-- 文本框样式 -->
    <style name="EditTextStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/page_background_night</item>
        <item name="backgroundTint">@color/theme_blue</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <!-- 底部导航栏样式 -->
    <style name="NaviStyle">
        <item name="itemTextColor">@color/bottom_navigation_selector</item>
        <item name="itemIconTint">@color/bottom_navigation_selector</item>
        <item name="itemRippleColor">@color/ripple_night</item>
        <item name="android:background">@color/card_background_night</item>
    </style>

    <!-- TabLayout样式 -->
    <style name="TabLayoutStyle">
        <item name="tabTextColor">@color/tab_layout_selector</item>
        <item name="tabIndicatorColor">@color/theme_blue_night</item>
    </style>
</resources>