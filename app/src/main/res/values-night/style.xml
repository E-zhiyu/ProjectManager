<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 标题文本样式 -->
    <style name="TitleStyle">
        <item name="android:textSize">23sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- 普通页面样式 -->
    <style name="CommonPageStyle">
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:background">@color/page_background_night</item>
    </style>

    <!-- 提示文本视图样式 -->
    <style name="TipTextViewStyle">
        <item name="android:paddingTop">10dp</item>
        <item name="android:textColor">@color/unchecked_gray_night</item>
        <item name="android:drawableStart">@drawable/baseline_error_outline_24</item>
        <item name="drawableTint">@color/unchecked_gray_night</item>
    </style>

    <!-- 新建流水界面卡片容器样式 -->
    <style name="NewRunningAccountCardStyle">
        <item name="cardBackgroundColor">@color/page_background_night</item>
    </style>

    <!-- 按钮样式 -->
    <style name="BtnStyle" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:padding">10dp</item>
    </style>

    <!-- AppBarLayout样式 -->
    <style name="AppBarLayoutStyle" parent="Widget.Material3.AppBarLayout">
        <item name="android:backgroundTint">@color/page_background_night</item>
    </style>

    <!-- SearchView样式 -->
    <style name="SearchViewStyle" parent="Widget.Material3.SearchView">
        <item name="backgroundTint">@color/page_background_night</item>
    </style>

    <!-- TabLayout样式 -->
    <style name="TabLayoutStyle" parent="android:Widget">
        <item name="android:background">@color/page_background_night</item>
        <item name="tabTextColor">@color/tab_layout_selector</item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
    </style>
</resources>