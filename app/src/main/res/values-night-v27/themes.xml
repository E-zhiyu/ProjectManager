<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ManagerAssistant.Static" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/color_primary_night</item>
        <item name="colorOnPrimary">@color/color_on_primary_night</item>
        <item name="colorPrimaryContainer">@color/color_primary_container_night</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondaryContainer">@color/color_secondary_container_night</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <!-- Customize your theme here. -->
        <item name="colorSurface">@color/color_surface_night</item>
        <item name="colorSurfaceContainer">@color/color_surface_container_night</item>
        <item name="colorSurfaceContainerLow">@color/color_surface_container_low_night
        </item>

        <item name="toolbarStyle">@style/ToolBarStyle</item>
        <item name="drawableTint">?attr/colorPrimary</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.ManagerAssistant.Dynamic" parent="Theme.Material3.DynamicColors.Dark.NoActionBar">
        <!-- 自定义颜色和样式 -->
        <item name="toolbarStyle">@style/ToolBarStyle</item>
        <item name="drawableTint">?attr/colorPrimary</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>