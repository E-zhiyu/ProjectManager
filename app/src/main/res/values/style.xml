<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 标题栏样式 -->
    <style name="ToolBarStyle" parent="Widget.Material3.Toolbar.OnSurface">
        <item name="android:backgroundTint">?attr/colorSurface</item>
        <item name="navigationIconTint">?attr/colorPrimary</item>
        <item name="navigationIcon">@drawable/outline_arrow_back_ios_new_24</item>
        <item name="contentInsetStart">10dp</item>
        <item name="titleTextAppearance">?attr/textAppearanceHeadlineSmall</item>
    </style>

    <!-- 文本样式基类 -->
    <style name="TextViewStyleBase">
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- 中等标题文本视图样式 -->
    <style name="MediumTitleTextViewStyle" parent="TextViewStyleBase">
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
    </style>

    <!-- 大标题文本视图样式 -->
    <style name="LargeTitleTextViewStyle" parent="TextViewStyleBase">
        <item name="android:textAppearance">?attr/textAppearanceTitleLarge</item>
    </style>

    <!-- 大字号内容文本视图样式 -->
    <style name="LargeBodyTextViewStyle" parent="TextViewStyleBase">
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
    </style>

    <!-- 中等字号内容文本视图样式 -->
    <style name="MediumBodyTextViewStyle" parent="TextViewStyleBase">
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
    </style>

    <!-- 可点击的文本框样式 -->
    <style name="ClickableTextViewStyle">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:drawablePadding">15dp</item>
        <item name="android:paddingStart">20dp</item>
    </style>

    <!-- 缩小版标签文本样式 -->
    <style name="SmallTitleTextViewStyle" parent="TextViewStyleBase">
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
    </style>

    <!-- 提示文本视图样式 -->
    <style name="TipTextViewStyle">
        <item name="android:paddingTop">10dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableStart">@drawable/outline_info_24</item>
        <item name="drawableTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="CardStyleBase" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card_background_color</item>
    </style>

    <!-- 圆角卡片容器器样式 -->
    <style name="RoundCardStyle" parent="CardStyleBase">
        <item name="cardCornerRadius">50dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <!-- 带有多项内容的卡片容器 -->
    <style name="ContentCardStyle" parent="CardStyleBase">
        <item name="cardCornerRadius">15dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <!-- 设置项样式 -->
    <style name="SettingOptionStyle">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/ripple_rectangle</item>
    </style>

    <!-- 开关样式 -->
    <style name="SwitchBtnStyle" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:drawablePadding">5dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:padding">10dp</item>
    </style>

    <!-- 按钮样式 -->
    <style name="CommonBtnStyle" parent="Widget.Material3.Button">
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="layout_goneMarginStart">5dp</item>
        <item name="layout_goneMarginEnd">5dp</item>
        <item name="layout_goneMarginTop">5dp</item>
        <item name="layout_goneMarginBottom">5dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- 透明背景按钮样式 -->
    <style name="TextBtnStyle" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="iconPadding">2dp</item>
    </style>

    <!-- 仅保留边框的按钮样式 -->
    <style name="OutlinedBtnStyle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
    </style>

    <!-- 图标按钮样式 -->
    <style name="ImageButtonStyle" parent="Widget.AppCompat.ImageButton">
        <item name="tint">?attr/colorPrimary</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/ripple_circle</item>
    </style>

    <style name="AddFloatingActionBtnStyle" parent="ThemeOverlay.Material3.FloatingActionButton.Primary">
        <item name="android:src">@drawable/outline_add_24</item>
        <item name="backgroundTint">?attr/colorTertiaryContainer</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:layout_marginBottom">20dp</item>
    </style>

    <style name="ImageViewStyle">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="tint">?attr/colorPrimary</item>
        <item name="android:padding">10dp</item>
    </style>

    <!-- 复选框样式 -->
    <style name="CheckBoxStyle">
        <item name="buttonTint">?attr/colorPrimary</item>
    </style>

    <!-- 普通文本框布局样式 -->
    <style name="CommonTextInputLayoutStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="errorEnabled">true</item>
        <item name="counterEnabled">true</item>
        <item name="helperTextEnabled">true</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="endIconDrawable">@drawable/baseline_clear_24</item>
        <item name="endIconMode">clear_text</item>
    </style>

    <style name="DropdownMenuTextInputLayoutStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu">
        <item name="errorEnabled">true</item>
        <item name="helperTextEnabled">true</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <!-- 需要用户输入文本的文本框样式 -->
    <style name="UserInputEditTextStyle" parent="Widget.Material3.TextInputEditText.OutlinedBox.Dense">
        <item name="android:inputType">text</item>
        <item name="android:textColorHighlight">?attr/colorSurfaceVariant</item>
        <item name="android:maxLength">20</item>
    </style>

    <!-- 自动填充文本框样式 -->
    <style name="UneditableAutoCompleteTextViewStyle" parent="Widget.Material3.AutoCompleteTextView.OutlinedBox.Dense">
        <item name="android:inputType">none</item>
        <item name="maxLines">1</item>
        <item name="android:textColorHighlight">?attr/colorControlHighlight</item>
    </style>

    <!-- 可编辑的自动填充文本框样式 -->
    <style name="EditableAutoCompleteTextViewStyle" parent="UneditableAutoCompleteTextViewStyle">
        <item name="android:inputType">text</item>
        <item name="maxLines">1</item>
    </style>

    <!-- AppBarLayout样式 -->
    <style name="AppBarLayoutStyle" parent="Widget.Material3.AppBarLayout">
        <item name="android:background">?attr/colorSurface</item>
    </style>

    <!-- SearchBar样式 -->
    <style name="SearchBarStyle" parent="Widget.Material3.SearchBar">
        <item name="backgroundTint">?attr/colorSurface</item>
    </style>

    <!-- SearchView样式 -->
    <style name="SearchViewStyle" parent="Widget.Material3.SearchView">
        <item name="backgroundTint">?attr/colorSurfaceContainer</item>
    </style>

    <!-- 底部导航栏样式 -->
    <style name="NaviStyle" parent="Widget.Material3.BottomNavigationView">
        <item name="itemTextColor">@color/bottom_navigation_selector</item>
        <item name="itemIconTint">@color/bottom_navigation_selector</item>
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="itemActiveIndicatorStyle">@style/NaviActiveIndicator</item>
    </style>

    <!-- 底部导航栏指示器颜色 -->
    <style name="NaviActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorSecondaryContainer</item>
    </style>

    <!-- TabLayout样式 -->
    <style name="TabLayoutStyle" parent="android:Widget">
        <item name="android:backgroundTint">?attr/colorSurface</item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
    </style>
</resources>