<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 标题栏样式 -->
    <style name="ToolBarStyle" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/toolbar_background</item>
        <item name="navigationIconTint">@color/theme_blue</item>
        <item name="contentInsetStart">10dp</item>
        <item name="titleTextAppearance">@style/TitleStyle</item>
    </style>

    <!-- 标题文本样式 -->
    <style name="TitleStyle">
        <item name="android:textSize">23sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- 页面样式 -->
    <style name="PageStyle">
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:background">@color/page_background</item>
    </style>

    <!-- 报表内容文本视图样式 -->
    <style name="ReportInfoTextViewStyle">
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingLeft">35dp</item>
    </style>

    <!-- 标签文本视图样式 -->
    <style name="LabelTextViewStyle">
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- 圆角卡片容器器样式 -->
    <style name="RoundCardStyle">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">50dp</item>
        <item name="android:layout_margin">10dp</item>
    </style>

    <!-- 透明背景卡片容器样式 -->
    <style name="TransparentCardStyle">
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="strokeColor">@android:color/transparent</item>
    </style>

    <!-- 带有多项内容的卡片容器 -->
    <style name="ContentCardStyle">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">10dp</item>
        <item name="android:layout_margin">10dp</item>
    </style>

    <!-- 子设置项卡片容器样式 -->
    <style name="SubSettingCardStyle">
        <item name="android:drawableEnd">@drawable/baseline_keyboard_arrow_right_24</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:padding">10dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- 流水视图样式 -->
    <style name="RunningAccountViewStyle">
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>

    <!-- 新建流水界面卡片容器样式 -->
    <style name="NewRunningAccountCardStyle">
        <item name="cardBackgroundColor">@color/page_background</item>
    </style>

    <!-- 按钮样式 -->
    <style name="BtnStyle" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/theme_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:padding">10dp</item>
    </style>

    <!-- 透明背景按钮样式 -->
    <style name="TransparentBtnStyle" parent="Widget.Material3.Button">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/theme_blue</item>
        <item name="iconPadding">2dp</item>
    </style>

    <!-- 图标按钮样式 -->
    <style name="ClickableImageViewStyle" parent="Widget.AppCompat.ImageButton">
        <item name="tint">@color/theme_blue</item>
        <item name="android:padding">10sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 复选框样式 -->
    <style name="CheckBoxStyle">
        <item name="buttonTint">@color/theme_blue</item>
    </style>

    <!-- 文本框布局样式 -->
    <style name="TextInputLayoutStyle" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="boxBackgroundColor">@color/page_background</item>
        <item name="backgroundTint">@color/theme_blue</item>
        <item name="boxStrokeColor">@color/text_input_edittext_border_selector</item>
        <item name="cursorColor">@color/theme_blue</item>
    </style>

    <!-- 需要用户输入文本的文本框样式 -->
    <style name="UserInputEditTextStyle" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:inputType">text</item>
        <item name="android:maxLength">20</item>
    </style>

    <!-- 底部导航栏样式 -->
    <style name="NaviStyle" parent="Widget.Material3.BottomNavigationView">
        <item name="itemTextColor">@color/bottom_navigation_selector</item>
        <item name="itemIconTint">@color/bottom_navigation_selector</item>
        <item name="itemRippleColor">@color/ripple</item>
        <item name="backgroundTint">@color/card_background</item>
        <item name="itemActiveIndicatorStyle">@style/NaviActiveIndicator</item>
    </style>

    <!-- 底部导航栏指示器颜色 -->
    <style name="NaviActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/navi_indicator</item>
    </style>

    <!-- TabLayout样式 -->
    <style name="TabLayoutStyle" parent="android:Widget">
        <item name="android:background">@color/page_background</item>
        <item name="tabTextColor">@color/tab_layout_selector</item>
        <item name="tabIndicatorColor">@color/theme_blue</item>
        <item name="tabRippleColor">@color/ripple</item>
    </style>

    <!-- 普通文本样式 -->
    <style name="CommonTextAppearance">
        <item name="android:textSize">17sp</item>
    </style>
</resources>