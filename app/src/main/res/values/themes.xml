<resources>
    <!-- Base application theme. -->
    <style name="Theme.ManagerAssistant.Static" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/theme_blue</item>
        <item name="colorPrimaryContainer">@color/card_background</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondaryContainer">@color/theme_secondary_container</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorSecondaryContainer</item>
        <!-- Customize your theme here. -->
        <item name="colorSurface">@color/page_background</item>
        <item name="colorOnSurfaceVariant">@color/unchecked_gray</item>

        <item name="toolbarStyle">@style/ToolBarStyle</item>
        <item name="drawableTint">?attr/colorPrimary</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 动态配色主题 -->
    <style name="Theme.ManagerAssistant.Dynamic" parent="Theme.Material3.DynamicColors.Light.NoActionBar">
        <!-- 自定义颜色和样式 -->
        <item name="toolbarStyle">@style/ToolBarStyle</item>
        <item name="drawableTint">?attr/colorPrimary</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="android:statusBarColor">?attr/colorSecondaryContainer</item>
    </style>
</resources>