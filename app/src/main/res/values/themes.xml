<resources>
    <!-- Base application theme. -->
    <style name="Theme.ProjectManager" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/theme_blue</item>
        <item name="colorPrimaryVariant">@color/theme_blue_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/page_background</item>
        <!-- Customize your theme here. -->
        <item name="toolbarStyle">@style/ToolBarStyle</item>
        <item name="drawableTint">@color/theme_blue</item>
        <item name="colorControlActivated">@color/theme_blue</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>