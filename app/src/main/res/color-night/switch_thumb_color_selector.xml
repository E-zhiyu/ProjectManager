<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下状态（checked + pressed） -->
    <item android:color="@color/theme_blue_variant_night" android:state_checked="true" />

    <!-- 默认打开状态 -->
    <item android:color="@color/theme_blue_night" android:state_checked="true" />

    <!-- 关闭状态 -->
    <item android:color="@color/unchecked_gray_night" />
</selector>