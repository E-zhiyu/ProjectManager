<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    tools:context=".ui.pages.setting.SettingFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- 主题模式 -->
        <include
            android:id="@+id/theme_mode_option"
            layout="@layout/view_setting_option"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp" />

        <!-- 动态色彩 -->
        <include
            android:id="@+id/dynamic_color_option"
            layout="@layout/view_setting_option" />

        <!-- 启动界面 -->
        <include
            android:id="@+id/first_screen_option"
            layout="@layout/view_setting_option" />

        <!-- 权限管理 -->
        <include
            android:id="@+id/permissions_option"
            layout="@layout/view_setting_option" />

        <!-- 导出数据 -->
        <include
            android:id="@+id/export_data_option"
            layout="@layout/view_setting_option"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="10dp" />

        <!-- 导入数据 -->
        <include
            android:id="@+id/import_data_option"
            layout="@layout/view_setting_option" />

        <!-- 清空流水记录 -->
        <include
            android:id="@+id/clear_account_data_option"
            layout="@layout/view_setting_option" />

        <!-- 自动备份 -->
        <include
            android:id="@+id/auto_backup_option"
            layout="@layout/view_setting_option" />

        <LinearLayout
            android:id="@+id/auto_backup_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 自动备份频率 -->
            <include
                android:id="@+id/backup_frequency_option"
                layout="@layout/view_setting_option" />

            <!-- 自动备份目录 -->
            <include
                android:id="@+id/backup_directory_option"
                layout="@layout/view_setting_option" />
        </LinearLayout>

        <!-- 自动记账 -->
        <include
            android:id="@+id/auto_bookkeeping_option"
            layout="@layout/view_setting_option"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="10dp" />

        <!-- 关于软件 -->
        <include
            android:id="@+id/about_option"
            layout="@layout/view_setting_option"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="10dp" />

        <!-- 更新日志 -->
        <include
            android:id="@+id/update_log_option"
            layout="@layout/view_setting_option" />

        <!-- 检测更新 -->
        <include
            android:id="@+id/update_check_option"
            layout="@layout/view_setting_option" />
    </LinearLayout>
</ScrollView>