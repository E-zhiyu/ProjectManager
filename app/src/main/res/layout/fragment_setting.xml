<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CommonPageStyle"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    tools:context=".ui.pages.setting.SettingFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            style="@style/ContentCardStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/app_settings_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/LargeTitleTextViewStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting" />

                <include
                    android:id="@+id/theme_mode_option"
                    layout="@layout/view_setting_option" />

                <include
                    android:id="@+id/dynamic_color_option"
                    layout="@layout/view_setting_option" />

                <include
                    android:id="@+id/first_screen_option"
                    layout="@layout/view_setting_option" />

                <include
                    android:id="@+id/permissions_option"
                    layout="@layout/view_setting_option" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/ContentCardStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/data_manage_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/LargeTitleTextViewStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/data_manage" />

                <include
                    android:id="@+id/export_data_option"
                    layout="@layout/view_setting_option" />

                <include
                    android:id="@+id/import_data_option"
                    layout="@layout/view_setting_option" />

                <include
                    android:id="@+id/clear_account_data_option"
                    layout="@layout/view_setting_option" />

                <include
                    android:id="@+id/auto_backup_option"
                    layout="@layout/view_setting_option" />

                <LinearLayout
                    android:id="@+id/auto_backup_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include
                        android:id="@+id/backup_frequency_option"
                        layout="@layout/view_setting_option" />

                    <include
                        android:id="@+id/backup_directory_option"
                        layout="@layout/view_setting_option" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/ContentCardStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/auto_bookkeeping_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/LargeTitleTextViewStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_bookkeeping" />

                <include
                    android:id="@+id/notification_analysis_switch_option"
                    layout="@layout/view_setting_option" />

                <LinearLayout
                    android:id="@+id/rule_manage_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rule_manage_option"
                        layout="@layout/view_setting_option" />

                    <include
                        android:id="@+id/reset_rule_option"
                        layout="@layout/view_setting_option" />
                </LinearLayout>

                <include
                    android:id="@+id/notification_cancel_behaviour"
                    layout="@layout/view_setting_option" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/ContentCardStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/about_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/LargeTitleTextViewStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about" />

                <include
                    android:id="@+id/about_option"
                    layout="@layout/view_setting_option" />

                <include
                    android:id="@+id/update_log_option"
                    layout="@layout/view_setting_option" />

                <include
                    android:id="@+id/update_check_option"
                    layout="@layout/view_setting_option" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>