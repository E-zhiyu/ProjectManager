<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bookkeeping_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.bookkeeping.running_account_edit.BookKeepingFragment">

    <!-- 顶部按钮视图 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_card_view"
        style="@style/RoundCardStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/bookkeeping_days_text"
                style="@style/LabelTextViewStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:paddingBottom="0sp"
                android:text="@string/num_of_bookkeeping_days" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/account_num_text"
                style="@style/LabelTextViewStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:paddingTop="0sp"
                android:paddingBottom="0sp"
                android:text="@string/num_of_running_account" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingBottom="7sp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/running_account_add_btn"
                    style="@style/BtnStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/running_account_add" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/report_btn"
                    style="@style/BtnStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/check_report" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 流水列表视图 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/running_account_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1" />
</LinearLayout>